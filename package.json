{
  "name": "icloud-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server on Cloudflare Workers proxying iCloud Mail (IMAP), Calendar (CalDAV), and Contacts (CardDAV)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen:hostname": "node scripts/write-hostname.mjs",
    "pretypecheck": "node scripts/write-hostname.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/write-hostname.mjs",
    "test": "vitest run",
    "test:quick": "vitest run --reporter=dot",
    "predeploy": "node scripts/write-hostname.mjs",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke-unauthenticated.mjs",
    "scan": "node scripts/forbidden-tokens.mjs",
    "docs:tools": "node scripts/tool-table.mjs --check",
    "prepare": "husky && node scripts/write-hostname.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "aws4fetch": "1.0.20",
    "ical.js": "2.2.1",
    "postal-mime": "3.0.0",
    "tsdav": "2.3.4",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261004.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "ip-address": "10.7.3",
    "miniflare": "5.20261001.0-alpha",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "undici": "7.29.1",
    "wrangler": "4.147.0"
  }
}
